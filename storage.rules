rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Journal images and PDFs: anyone reads, only admins upload or delete.
    // Keep this email list identical to firestore.rules.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in ['animxanimx@gmail.com', 'ofouqacademie@gmail.com'];
    }
  }
}
