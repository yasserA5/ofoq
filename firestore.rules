rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Accounts that may use the admin panel. Add other editors' emails here.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['animxanimx@gmail.com', 'ofouqacademie@gmail.com'];
    }
    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function userFieldsOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'email', 'provider', 'displayName', 'photoURL', 'phone', 'affiliation',
                               'specialty', 'bio', 'createdAt', 'lastLogin', 'loginCount', 'updatedAt'])
        && d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 80;
    }

    // Published journal content: anyone reads, only admins write
    match /content/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // A person's own profile
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) && userFieldsOk() && request.resource.data.uid == uid;
      allow update: if isSelf(uid) && userFieldsOk()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'createdAt']);
      allow delete: if isAdmin();
    }

    // Anonymous per-browser record: write-only for visitors
    match /visitors/{id} {
      allow read: if isAdmin();
      allow create, update: if id.size() <= 64
        && request.resource.data.keys().hasOnly(['firstSeen', 'lastSeen', 'visits', 'device', 'lang', 'uid', 'name']);
    }

    // Daily counters: write-only for visitors. Page views can only go up by one.
    // Other counters are not bounded: a determined visitor could inflate them.
    match /stats_daily/{day} {
      allow read: if isAdmin();
      allow create, update: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['views', 'sessions', 'visitors', 'newVisitors', 'logins', 'signups',
                                                 'pages', 'items', 'sources', 'devices', 'langs']);
    }

    // Newsletter sign-ups
    match /subscribers/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'lang', 'createdAt'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 200;
      allow read, delete: if isAdmin();
    }
  }
}
